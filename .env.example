# ===== Obligatorias =====
JARVIS_PASSWORD=cambia-esta-clave-larga
ANTHROPIC_API_KEY=sk-ant-...
# URL pública donde queda la app (sin / al final). Se usa para el callback de Google.
PUBLIC_URL=https://jarvis.tu-dominio.com

# Clave aparte para la tablet de la cocina (/panel.html). Solo agenda, lista, temporizadores, clima, casa y medios:
# nada de correo ni memoria. Mínimo 8 caracteres, distinta de JARVIS_PASSWORD.
# PANEL_PASSWORD=otra-clave-larga

# ===== Google (Calendar + Gmail) =====
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Opcional: por defecto es PUBLIC_URL + /auth/google/callback
# GOOGLE_REDIRECT_URI=

# ===== Personalidad =====
ASSISTANT_NAME=Jarvis
USER_NAME=Alejandro
TIMEZONE=America/Bogota
# USER_CONTEXT=Texto libre con quién eres y qué haces (si lo omites, usa el contexto por defecto)
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=1500

# ===== n8n: tus flujos como herramientas (JSON en una sola línea). También puedes usar /data/flujos.json =====
# N8N_FLOWS=[{"nombre":"registrar_gasto","descripcion":"Registra un gasto. Datos: monto (número), categoria, descripcion","url":"https://TU-N8N/webhook/xxxx"}]

# ===== Voz en el servidor (Whisper). Groq es gratis: console.groq.com =====
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...   (alternativa de pago)
# STT_PROVIDER=groq

# ===== Panel de la casa =====
# Clima (Open-Meteo, sin clave). Por defecto Villavicencio.
# WEATHER_LAT=4.142
# WEATHER_LON=-73.6266
# WEATHER_PLACE=Villavicencio
# Gasto del mes: ID de la hoja de finanzas (entre /d/ y /edit en su URL) y nombre de la pestaña de gastos
# FINANCE_SHEET_ID=
# FINANCE_GASTOS_SHEET=Gastos
# Palabra de activación "Jarvis" en la tablet (gratis para uso personal en console.picovoice.ai)
# PICOVOICE_ACCESS_KEY=

# ===== YouTube: videos en la app. Clave gratis de "YouTube Data API v3" en Google Cloud =====
# YOUTUBE_API_KEY=AIza...

# ===== Home Assistant (cuando lo tengas) =====
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=token-de-acceso-de-larga-duracion

# ===== Servidor =====
PORT=3000
# DATA_DIR=/data
